<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subtitles — Apple Design Demonstration</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        apple: {
                            blue: '#0071e3',
                            blueHover: '#0077ed',
                            darkBlue: '#005bb5',
                            systemGray: '#86868b',
                            card: 'rgba(28, 28, 32, 0.76)',
                            cardBorder: 'rgba(255, 255, 255, 0.12)',
                        }
                    },
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Text"', '"SF Pro Display"', '"PingFang SC"', '"Helvetica Neue"', 'sans-serif'],
                        mono: ['ui-monospace', '"SF Mono"', 'Menlo', 'Monaco', 'Consolas', 'monospace']
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- OpenCC for automatic Simplified Chinese conversion -->
    <script src="https://cdn.jsdelivr.net/npm/opencc-js@1.0.5/dist/umd/full.js"></script>
    <style>
        /* Apple SF Typography letter-spacing rules */
        body {
            font-feature-settings: "cv02", "cv03", "cv04", "cv11";
            -webkit-font-smoothing: antialiased;
            background: #000000;
            background-image: 
                radial-gradient(at 18% 12%, rgba(28, 38, 70, 0.38) 0px, transparent 65%),
                radial-gradient(at 85% 8%, rgba(45, 25, 60, 0.35) 0px, transparent 60%),
                radial-gradient(at 50% 90%, rgba(18, 25, 45, 0.45) 0px, transparent 70%);
            background-attachment: fixed;
        }

        /* Apple Material: Glass with Inset Specular Highlight (The Apple secret) */
        .apple-window {
            background: rgba(26, 26, 30, 0.78);
            backdrop-filter: blur(40px) saturate(190%);
            -webkit-backdrop-filter: blur(40px) saturate(190%);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 
                inset 0 1px 0 0 rgba(255, 255, 255, 0.16),
                0 28px 60px -15px rgba(0, 0, 0, 0.8),
                0 0 0 1px rgba(0, 0, 0, 0.6);
            border-radius: 20px;
        }

        .apple-glass-card {
            background: rgba(36, 36, 42, 0.65);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 
                inset 0 1px 0 0 rgba(255, 255, 255, 0.1),
                0 12px 28px -8px rgba(0, 0, 0, 0.5);
            border-radius: 16px;
        }

        /* Apple Segmented Control */
        .apple-segmented-track {
            background: rgba(0, 0, 0, 0.38);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 9px;
            padding: 2.5px;
        }

        .apple-segmented-active {
            background: rgba(255, 255, 255, 0.22);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.25);
            color: #ffffff;
            border-radius: 7px;
        }

        /* Apple Primary Blue Push Button */
        .apple-btn-primary {
            background: linear-gradient(180deg, #0077ed 0%, #0066cc 100%);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 
                inset 0 1px 0 0 rgba(255, 255, 255, 0.35),
                0 4px 14px 0 rgba(0, 113, 227, 0.38);
            transition: all 0.18s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .apple-btn-primary:hover:not(:disabled) {
            background: linear-gradient(180deg, #1a85f2 0%, #0071e3 100%);
            box-shadow: 
                inset 0 1px 0 0 rgba(255, 255, 255, 0.45),
                0 6px 18px 0 rgba(0, 113, 227, 0.48);
            transform: translateY(-0.5px);
        }
        .apple-btn-primary:active:not(:disabled) {
            transform: scale(0.985);
            box-shadow: 0 2px 6px rgba(0, 113, 227, 0.3);
        }

        /* Apple Secondary Glass Button */
        .apple-btn-secondary {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.18s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .apple-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.14);
            border-color: rgba(255, 255, 255, 0.2);
        }
        .apple-btn-secondary:active {
            transform: scale(0.98);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.18); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.3); }
    </style>
</head>
<body class="text-zinc-100 min-h-screen flex flex-col font-sans selection:bg-[#0071e3] selection:text-white pb-12">

    <!-- macOS Inspired Top Menu Bar -->
    <header class="border-b border-white/[0.08] bg-[#16161a]/60 backdrop-blur-2xl sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-5 h-12 flex items-center justify-between">
            <!-- Left: macOS Window Controls & Title -->
            <div class="flex items-center space-x-3.5">
                <div class="flex items-center space-x-2">
                    <span class="w-3 h-3 rounded-full bg-[#ff5f56] border border-[#e0443e]/50 inline-block shadow-sm"></span>
                    <span class="w-3 h-3 rounded-full bg-[#ffbd2e] border border-[#dea123]/50 inline-block shadow-sm"></span>
                    <span class="w-3 h-3 rounded-full bg-[#27c93f] border border-[#1aab29]/50 inline-block shadow-sm"></span>
                </div>
                <div class="h-3.5 w-px bg-white/10 mx-1"></div>
                <div class="flex items-center space-x-1.5">
                    <i class="fa-brands fa-apple text-sm text-zinc-300"></i>
                    <span class="text-xs font-semibold tracking-tight text-white/90">Subtitles Pro</span>
                    <span class="text-[10px] text-zinc-400 font-mono px-1.5 py-0.5 rounded bg-white/[0.06] border border-white/[0.08] ml-1">macOS Edition</span>
                </div>
            </div>

            <!-- Right: WebGPU Badge & Model Cache Manager & Lang Switch -->
            <div class="flex items-center space-x-3 text-xs">
                <!-- GPU Engine Chip -->
                <div id="gpuBadge" class="hidden sm:flex items-center space-x-1.5 text-[11px] px-2.5 py-1 rounded-full bg-white/[0.06] border border-white/[0.1] text-zinc-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" id="gpuDot"></span>
                    <span id="gpuText">WebGPU 硬件加速</span>
                </div>

                <!-- Storage Pill -->
                <button id="cleanCacheBtn" class="flex items-center space-x-1.5 text-[11px] px-2.5 py-1 rounded-full apple-btn-secondary text-zinc-300 transition" title="管理模型本地持久化存储">
                    <i class="fa-solid fa-server text-[10px] text-zinc-400"></i>
                    <span id="cleanCacheText">检查缓存...</span>
                </button>

                <!-- Apple Segmented Language Switcher -->
                <div class="apple-segmented-track flex items-center">
                    <button id="langZhBtn" class="px-2.5 py-0.5 text-[11px] font-medium transition apple-segmented-active">中文</button>
                    <button id="langEnBtn" class="px-2.5 py-0.5 text-[11px] font-medium transition text-zinc-400 hover:text-white">English</button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Workspace Window (macOS Sequoia Window Style) -->
    <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 pt-8 w-full space-y-6">

        <!-- App Window Header -->
        <div class="text-center space-y-2 py-4">
            <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-white" id="heroTitle">
                智能音视频字幕提取
            </h1>
            <p class="text-sm text-zinc-400 max-w-xl mx-auto font-normal leading-relaxed" id="heroSubtitle">
                基于 Apple HIG 理念设计与 WebGPU 本地神经网络，全流程封闭于浏览器内完成高精度语音对齐。
            </p>
        </div>

        <!-- Master Glass Window -->
        <div class="apple-window p-6 sm:p-8 space-y-6">

            <!-- File Drop Zone (AirDrop Style) -->
            <div id="dropZone" class="border border-dashed border-white/15 hover:border-white/35 rounded-2xl p-8 sm:p-10 text-center transition cursor-pointer bg-black/25 hover:bg-black/35 group relative overflow-hidden">
                <input type="file" id="fileInput" class="hidden" accept="video/*,audio/*,.mp4,.mkv,.mov,.webm,.mp3,.wav,.m4a">
                <div class="flex flex-col items-center space-y-3 relative z-10">
                    <div class="w-12 h-12 rounded-2xl bg-white/[0.08] group-hover:bg-[#0071e3]/20 border border-white/10 group-hover:border-[#0071e3]/40 flex items-center justify-center transition-all duration-300">
                        <i class="fa-solid fa-arrow-up-from-bracket text-lg text-zinc-300 group-hover:text-[#0a84ff] transition"></i>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-white tracking-tight" id="dropTitle">
                            将媒体文件拖移至此处，或轻点上传
                        </p>
                        <p class="text-xs text-zinc-400 mt-1" id="dropSubtitle">
                            支持 MP4, MOV, WebM, MP3, WAV, M4A 等主流音视频格式
                        </p>
                    </div>
                    <div id="fileInfo" class="hidden mt-2 text-xs font-mono font-medium text-blue-300 bg-blue-950/40 px-3 py-1 rounded-full border border-blue-500/30">
                    </div>
                </div>
            </div>

            <!-- Parameters Configuration Grid (macOS Control Center Cards) -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
                
                <!-- Model Precision -->
                <div class="apple-glass-card p-3.5 space-y-1.5">
                    <label class="block text-[11px] font-medium text-zinc-400 uppercase tracking-wider" id="labelModel">模型精度</label>
                    <select id="modelSelect" class="w-full bg-black/40 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-[#0071e3] transition">
                        <option value="onnx-community/whisper-small" selected>Whisper Small（高精度 · 推荐）</option>
                        <option value="onnx-community/whisper-base">Whisper Base（极速响应）</option>
                    </select>
                </div>

                <!-- Language -->
                <div class="apple-glass-card p-3.5 space-y-1.5">
                    <label class="block text-[11px] font-medium text-zinc-400 uppercase tracking-wider" id="labelLang">识别原声语言</label>
                    <select id="langSelect" class="w-full bg-black/40 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-[#0071e3] transition">
                        <option value="chinese" selected>中文（普通话 / 粤语）</option>
                        <option value="english">英语（English）</option>
                        <option value="japanese">日语（日本語）</option>
                        <option value="auto">自动检测（Auto Detect）</option>
                        <option value="spanish">西班牙语（Spanish）</option>
                        <option value="korean">韩语（Korean）</option>
                    </select>
                </div>

                <!-- Engine -->
                <div class="apple-glass-card p-3.5 space-y-1.5">
                    <label class="block text-[11px] font-medium text-zinc-400 uppercase tracking-wider" id="labelDevice">计算架构</label>
                    <select id="deviceSelect" class="w-full bg-black/40 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-zinc-200 focus:outline-none focus:border-[#0071e3] transition">
                        <option value="webgpu" selected>WebGPU（Apple Silicon / 独显加速）</option>
                        <option value="wasm">CPU WASM（标准备用）</option>
                    </select>
                </div>
            </div>

            <!-- Primary Execute Button -->
            <button id="startBtn" disabled class="w-full py-3 px-5 rounded-xl font-medium text-sm text-white apple-btn-primary disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center justify-center space-x-2">
                <i class="fa-solid fa-sparkles text-xs"></i>
                <span id="startBtnText">开始分析与转写</span>
            </button>

            <!-- Dynamic Progress Card (iOS Liquid Style) -->
            <div id="progressSection" class="hidden apple-glass-card p-5 space-y-3.5 transition-all">
                <div class="flex items-center justify-between text-xs">
                    <div class="flex items-center space-x-2">
                        <span class="w-2 h-2 rounded-full bg-[#0a84ff] animate-ping"></span>
                        <span id="statusMessage" class="font-medium text-zinc-200">准备中...</span>
                    </div>
                    <span id="percentText" class="font-mono font-semibold text-[#0a84ff]">0%</span>
                </div>

                <!-- Apple Style Liquid Progress Bar -->
                <div class="w-full bg-black/40 rounded-full h-2 p-0.5 border border-white/10 overflow-hidden">
                    <div id="progressBar" class="bg-gradient-to-r from-[#0071e3] to-[#409cff] h-full rounded-full transition-all duration-300 w-0"></div>
                </div>

                <div class="flex items-center justify-between text-[11px] text-zinc-400 font-mono">
                    <span id="subStageFile">正在建立神经网络张量上下文</span>
                    <span id="subStageStatus">Step 1/2</span>
                </div>
            </div>

            <!-- Workspace Results (macOS Final Cut Pro Preview & Inspector Layout) -->
            <div id="resultSection" class="hidden space-y-4 pt-2">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/10 pb-3">
                    <div class="flex items-center space-x-2.5">
                        <h2 class="text-sm font-semibold text-white tracking-tight" id="resultTitle">转写已完成</h2>
                        <span id="speedBadge" class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-white/[0.08] text-zinc-300 border border-white/10"></span>
                    </div>

                    <!-- Action Export Buttons -->
                    <div class="flex items-center flex-wrap gap-2">
                        <button id="downloadSrtBtn" class="text-xs font-medium px-3 py-1.5 rounded-lg apple-btn-primary text-white flex items-center space-x-1.5">
                            <i class="fa-solid fa-download text-[10px]"></i>
                            <span id="btnExportSrt">导出 .SRT 字幕</span>
                        </button>
                        <button id="downloadVttBtn" class="text-xs font-medium px-3 py-1.5 rounded-lg apple-btn-secondary text-zinc-200">
                            导出 .VTT
                        </button>
                        <button id="downloadTxtBtn" class="text-xs font-medium px-3 py-1.5 rounded-lg apple-btn-secondary text-zinc-200">
                            导出 .TXT
                        </button>
                        <button id="copyAllBtn" class="text-xs font-medium px-3 py-1.5 rounded-lg apple-btn-secondary text-zinc-200 flex items-center space-x-1">
                            <i class="fa-regular fa-copy text-[11px]"></i>
                            <span id="btnCopyAll">拷贝全文</span>
                        </button>
                    </div>
                </div>

                <!-- Two Column Preview Workspace -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
                    <!-- Media Player with Subtitle Overlay -->
                    <div class="lg:col-span-5 space-y-2">
                        <div class="bg-black/80 rounded-xl overflow-hidden border border-white/10 aspect-video flex items-center justify-center relative shadow-2xl">
                            <video id="videoPlayer" controls class="w-full h-full object-contain"></video>
                        </div>
                        <div class="text-[11px] text-zinc-400 flex items-center justify-between font-mono px-1">
                            <span id="previewTrackDesc">实时字幕挂载播放就绪</span>
                            <span id="totalDurationText">00:00</span>
                        </div>
                    </div>

                    <!-- Subtitle Segment Timeline List -->
                    <div class="lg:col-span-7 apple-glass-card p-3.5 flex flex-col h-[380px]">
                        <div class="text-[11px] font-medium text-zinc-400 mb-2.5 flex justify-between items-center pb-2 border-b border-white/10">
                            <span><span id="segTitleText">字幕分句轴</span>（<span id="segmentCount" class="font-mono text-zinc-200">0</span>）</span>
                            <span class="text-zinc-500 text-[10px]" id="segEditableHint">轻点文本即可原地校对修改</span>
                        </div>
                        <div id="subtitlesList" class="flex-1 overflow-y-auto space-y-2 pr-1">
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Documentation & HIG Technical Notes -->
        <section class="border-t border-white/10 pt-6 space-y-4">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-400" id="faqHeaderTitle">技术规格与人机交互说明</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-zinc-400" id="faqContainer">
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-white/[0.08] bg-black/40 backdrop-blur text-zinc-500 text-xs py-4 mt-auto">
        <div class="max-w-5xl mx-auto px-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px]">
            <p id="footerCopyright">Subtitles Pro · Designed with Apple Human Interface Guidelines</p>
            <div class="flex space-x-4 text-zinc-400">
                <a href="#" class="hover:text-white transition">隐私政策</a>
                <a href="#" class="hover:text-white transition">SRT 导出规范</a>
                <a href="#" class="hover:text-white transition">开发者支持</a>
            </div>
        </div>
    </footer>

    <!-- macOS System Modal Sheet -->
    <div id="uninstallModal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-md flex items-center justify-center p-4">
        <div class="apple-window max-w-sm w-full p-6 space-y-4 shadow-2xl">
            <div class="space-y-1.5">
                <h3 class="font-semibold text-white text-sm" id="modalTitle">移除本地 AI 模型数据</h3>
                <p class="text-xs text-zinc-300 leading-relaxed" id="modalDesc">
                    当前本地已持久化存储：<span id="modalCacheSize" class="font-mono font-semibold text-white">0 MB</span>。<br/>
                    确认彻底移除本地权重文件以释放磁盘空间？
                </p>
            </div>

            <div class="flex items-center justify-end space-x-2.5 pt-2">
                <button id="modalCancelBtn" class="px-3.5 py-1.5 rounded-lg text-xs font-medium text-zinc-300 apple-btn-secondary transition">
                    取消
                </button>
                <button id="modalConfirmBtn" class="px-3.5 py-1.5 rounded-lg text-xs font-medium text-white bg-red-600 hover:bg-red-500 transition shadow-lg shadow-red-600/30">
                    <span id="modalConfirmText">彻底移除</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Application Engine Script -->
    <script>
        // State
        let currentLang = 'zh';
        let currentMirror = 'china';
        let selectedFile = null;
        let audioFloat32 = null;
        let subtitleChunks = [];
        let worker = null;
        let vttBlobUrl = null;
        let currentCacheSizeBytes = 0;

        // Auto purge stale sandbox CacheStorage on startup
        if (window.caches) {
            caches.keys().then(keys => {
                for (const k of keys) caches.delete(k);
            }).catch(() => {});
        }

        // Apple HIG Localization Dictionary
        const i18n = {
            zh: {
                title: "Subtitles Pro — Apple Design Edition",
                heroTitle: "智能音视频字幕提取",
                heroSubtitle: "基于 Apple HIG 理念设计与 WebGPU 本地神经网络，全流程封闭于浏览器内完成高精度语音对齐。",
                dropTitle: "将媒体文件拖移至此处，或轻点上传",
                dropSubtitle: "支持 MP4, MOV, WebM, MP3, WAV, M4A 等主流音视频格式",
                labelModel: "模型精度",
                labelLang: "识别原声语言",
                labelDevice: "计算架构",
                startBtn: "开始分析与转写",
                btnExportSrt: "导出 .SRT 字幕",
                btnCopyAll: "拷贝全文",
                previewTrackDesc: "实时字幕挂载播放就绪",
                segTitleText: "字幕分句轴",
                segEditableHint: "轻点文本即可原地校对修改",
                step1Label: "Step 1/2: 模型初始化与权重同步",
                step2Label: "Step 2/2: WebGPU 显卡推理转写中",
                modalTitle: "移除本地 AI 模型数据",
                modalDesc: "当前本地已持久化存储：",
                modalCancel: "取消",
                modalConfirm: "彻底移除",
                faqs: [
                    {
                        q: "本地持久化与存储释放",
                        a: "首次使用时将同步所需精度的 Whisper 神经网络参数至本机（约 240MB~560MB）。完成落盘后后续运行直接由本地高速读取；可随时通过右上角一键释放磁盘空间。"
                    },
                    {
                        q: "文本规范化与繁简对齐",
                        a: "内置 OpenCC 词汇级规范化引擎与前置 Prompt 约束，自动将输出文本规整为国家通用规范汉字，消除传统 ASR 语料的繁体偏差。"
                    },
                    {
                        q: "主流剪辑软件对齐兼容",
                        a: "导出的 .SRT 文件采用标准 UTF-8 编码与精确毫秒级时间轴，可直接导入剪映专业版、Adobe Premiere Pro、Final Cut Pro 进行时间线同步。"
                    },
                    {
                        q: "端到端本地安全沙箱",
                        a: "音频解码与张量推理完全受限于本地 WebGPU / Web Worker 沙箱环境中，媒体源文件无需上传至任何远程服务器。"
                    }
                ],
                copyright: "Subtitles Pro · Designed with Apple Human Interface Guidelines"
            },
            en: {
                title: "Subtitles Pro — Apple Design Edition",
                heroTitle: "Speech-to-Text Subtitle Studio",
                heroSubtitle: "Engineered with Apple HIG design principles and client-side WebGPU neural inference.",
                dropTitle: "Drop media file here, or click to browse",
                dropSubtitle: "Supports MP4, MOV, WebM, MP3, WAV, M4A container formats",
                labelModel: "Model Precision",
                labelLang: "Audio Language",
                labelDevice: "Compute Architecture",
                startBtn: "Analyze & Transcribe",
                btnExportSrt: "Export .SRT",
                btnCopyAll: "Copy All",
                previewTrackDesc: "Live subtitle track mounted",
                segTitleText: "Subtitle Timeline",
                segEditableHint: "Click text to edit inline",
                step1Label: "Step 1/2: Synchronizing Neural Weights",
                step2Label: "Step 2/2: WebGPU Tensor Transcription",
                modalTitle: "Remove Local Model Storage",
                modalDesc: "Locally cached neural parameters: ",
                modalCancel: "Cancel",
                modalConfirm: "Remove",
                faqs: [
                    {
                        q: "Local Storage & Cache Control",
                        a: "On initial execution, Whisper ONNX weights are cached locally (~240MB-560MB). Subsequent transcriptions start instantaneously with 0 network latency. Storage can be reclaimed at any time via the top toolbar."
                    },
                    {
                        q: "Script Normalization",
                        a: "Integrated with OpenCC lexical engine and prompt steering to ensure standard simplified output, preventing traditional script leakage."
                    },
                    {
                        q: "NLE Compatibility",
                        a: "Exported .SRT files strictly adhere to standard subtitle specifications, ready for immediate drag-and-drop into Final Cut Pro, Premiere Pro, and CapCut."
                    },
                    {
                        q: "Private Local Sandboxing",
                        a: "All audio processing and neural tensor compute occur purely inside your local browser sandbox. No media bytes ever leave your device."
                    }
                ],
                copyright: "Subtitles Pro · Designed with Apple Human Interface Guidelines"
            }
        };

        // Elements
        const langZhBtn = document.getElementById('langZhBtn');
        const langEnBtn = document.getElementById('langEnBtn');
        const heroTitle = document.getElementById('heroTitle');
        const heroSubtitle = document.getElementById('heroSubtitle');
        const dropTitle = document.getElementById('dropTitle');
        const dropSubtitle = document.getElementById('dropSubtitle');
        const labelModel = document.getElementById('labelModel');
        const labelLang = document.getElementById('labelLang');
        const labelDevice = document.getElementById('labelDevice');
        const startBtn = document.getElementById('startBtn');
        const startBtnText = document.getElementById('startBtnText');
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const fileInfo = document.getElementById('fileInfo');
        const modelSelect = document.getElementById('modelSelect');
        const langSelect = document.getElementById('langSelect');
        const deviceSelect = document.getElementById('deviceSelect');
        const cleanCacheBtn = document.getElementById('cleanCacheBtn');
        const cleanCacheText = document.getElementById('cleanCacheText');
        const uninstallModal = document.getElementById('uninstallModal');
        const modalTitle = document.getElementById('modalTitle');
        const modalDesc = document.getElementById('modalDesc');
        const modalCacheSize = document.getElementById('modalCacheSize');
        const modalCancelBtn = document.getElementById('modalCancelBtn');
        const modalConfirmBtn = document.getElementById('modalConfirmBtn');
        const modalConfirmText = document.getElementById('modalConfirmText');
        const progressSection = document.getElementById('progressSection');
        const progressBar = document.getElementById('progressBar');
        const percentText = document.getElementById('percentText');
        const statusMessage = document.getElementById('statusMessage');
        const subStageFile = document.getElementById('subStageFile');
        const subStageStatus = document.getElementById('subStageStatus');
        const resultSection = document.getElementById('resultSection');
        const resultTitle = document.getElementById('resultTitle');
        const speedBadge = document.getElementById('speedBadge');
        const btnExportSrt = document.getElementById('btnExportSrt');
        const btnCopyAll = document.getElementById('btnCopyAll');
        const videoPlayer = document.getElementById('videoPlayer');
        const subtitlesList = document.getElementById('subtitlesList');
        const segmentCount = document.getElementById('segmentCount');
        const previewTrackDesc = document.getElementById('previewTrackDesc');
        const segTitleText = document.getElementById('segTitleText');
        const segEditableHint = document.getElementById('segEditableHint');
        const faqHeaderTitle = document.getElementById('faqHeaderTitle');
        const faqContainer = document.getElementById('faqContainer');
        const footerCopyright = document.getElementById('footerCopyright');
        const gpuDot = document.getElementById('gpuDot');
        const gpuText = document.getElementById('gpuText');

        // Language Switcher
        function switchLanguage(lang) {
            currentLang = lang;
            const d = i18n[lang];
            document.title = d.title;
            heroTitle.textContent = d.heroTitle;
            heroSubtitle.textContent = d.heroSubtitle;
            dropTitle.textContent = d.dropTitle;
            dropSubtitle.textContent = d.dropSubtitle;
            labelModel.textContent = d.labelModel;
            labelLang.textContent = d.labelLang;
            labelDevice.textContent = d.labelDevice;
            startBtnText.textContent = d.startBtn;
            btnExportSrt.textContent = d.btnExportSrt;
            btnCopyAll.textContent = d.btnCopyAll;
            previewTrackDesc.textContent = d.previewTrackDesc;
            segTitleText.textContent = d.segTitleText;
            segEditableHint.textContent = d.segEditableHint;
            footerCopyright.textContent = d.copyright;

            faqContainer.innerHTML = '';
            d.faqs.forEach(f => {
                const box = document.createElement('div');
                box.className = "apple-glass-card p-4";
                box.innerHTML = `<h4 class="font-medium text-white text-xs mb-1">${f.q}</h4><p class="leading-relaxed text-[11px] text-zinc-400">${f.a}</p>`;
                faqContainer.appendChild(box);
            });

            if (lang === 'zh') {
                langZhBtn.className = "px-2.5 py-0.5 text-[11px] font-medium transition apple-segmented-active";
                langEnBtn.className = "px-2.5 py-0.5 text-[11px] font-medium transition text-zinc-400 hover:text-white";
                currentMirror = 'china';
                langSelect.value = "chinese";
            } else {
                langEnBtn.className = "px-2.5 py-0.5 text-[11px] font-medium transition apple-segmented-active";
                langZhBtn.className = "px-2.5 py-0.5 text-[11px] font-medium transition text-zinc-400 hover:text-white";
                currentMirror = 'global';
                langSelect.value = "english";
            }
            updateCacheDisplay();
        }

        langZhBtn.addEventListener('click', () => switchLanguage('zh'));
        langEnBtn.addEventListener('click', () => switchLanguage('en'));

        // Check WebGPU capability
        async function checkWebGPU() {
            if (navigator.gpu) {
                try {
                    const adapter = await navigator.gpu.requestAdapter();
                    if (adapter) {
                        gpuDot.className = "w-1.5 h-1.5 rounded-full bg-emerald-400";
                        gpuText.textContent = "WebGPU 硬件加速";
                        deviceSelect.value = "webgpu";
                        return;
                    }
                } catch(e) {}
            }
            gpuDot.className = "w-1.5 h-1.5 rounded-full bg-amber-400";
            gpuText.textContent = "WASM CPU 模式";
            deviceSelect.value = "wasm";
        }
        checkWebGPU();

        // Reactive Storage Sync
        async function updateCacheDisplay() {
            try {
                const res = await fetch('/api/cache-info');
                const data = await res.json();
                currentCacheSizeBytes = data.sizeBytes || 0;
                const mb = (currentCacheSizeBytes / (1024 * 1024)).toFixed(1);
                if (currentCacheSizeBytes > 0) {
                    cleanCacheText.textContent = currentLang === 'zh' ? `已缓存: ${mb}MB` : `Storage: ${mb}MB`;
                } else {
                    cleanCacheText.textContent = currentLang === 'zh' ? `暂无缓存` : `Empty`;
                }
            } catch(e) {
                cleanCacheText.textContent = currentLang === 'zh' ? `存储空间` : `Storage`;
            }
        }
        updateCacheDisplay();

        cleanCacheBtn.addEventListener('click', async () => {
            await updateCacheDisplay();
            const mb = (currentCacheSizeBytes / (1024 * 1024)).toFixed(1);
            modalCacheSize.textContent = `${mb} MB`;
            const d = i18n[currentLang];
            modalTitle.textContent = d.modalTitle;
            modalCancelBtn.textContent = d.modalCancel;
            modalConfirmText.textContent = d.modalConfirm;
            uninstallModal.classList.remove('hidden');
        });

        modalCancelBtn.addEventListener('click', () => {
            uninstallModal.classList.add('hidden');
        });

        modalConfirmBtn.addEventListener('click', async () => {
            modalConfirmBtn.disabled = true;
            modalConfirmText.textContent = "...";
            try {
                if (window.caches) {
                    const keys = await caches.keys();
                    for (const k of keys) await caches.delete(k);
                }
                await fetch('/api/clear-cache', { method: 'POST' });
                await updateCacheDisplay();
                uninstallModal.classList.add('hidden');
            } catch (err) {
                alert("Error: " + err.message);
            } finally {
                modalConfirmBtn.disabled = false;
                modalConfirmText.textContent = i18n[currentLang].modalConfirm;
            }
        });

        // File Selection Handlers
        dropZone.addEventListener('click', () => fileInput.click());
        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-[#0071e3]/60', 'bg-black/40');
        });
        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-[#0071e3]/60', 'bg-black/40');
        });
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-[#0071e3]/60', 'bg-black/40');
            if (e.dataTransfer.files.length > 0) handleFileChosen(e.dataTransfer.files[0]);
        });
        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) handleFileChosen(e.target.files[0]);
        });

        function handleFileChosen(file) {
            selectedFile = file;
            const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
            fileInfo.classList.remove('hidden');
            fileInfo.textContent = `${file.name} (${sizeMb} MB)`;
            startBtn.disabled = false;
            videoPlayer.src = URL.createObjectURL(file);
        }

        // 16kHz Audio Resampling
        async function extractAudioData(file) {
            statusMessage.textContent = currentLang === 'zh' ? "正在提取音频波形数据..." : "Extracting audio waveform...";
            percentText.textContent = "10%";
            progressBar.style.width = "10%";
            subStageStatus.textContent = "Step 1/2";

            const arrayBuffer = await file.arrayBuffer();
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const decodedAudio = await audioCtx.decodeAudioData(arrayBuffer);

            statusMessage.textContent = currentLang === 'zh' ? "重采样为 16kHz 单声道..." : "Resampling 16kHz mono...";
            percentText.textContent = "25%";
            progressBar.style.width = "25%";

            const targetSampleRate = 16000;
            const offlineCtx = new OfflineAudioContext(1, decodedAudio.duration * targetSampleRate, targetSampleRate);
            const source = offlineCtx.createBufferSource();
            source.buffer = decodedAudio;
            source.connect(offlineCtx.destination);
            source.start(0);

            const renderedBuffer = await offlineCtx.startRendering();
            return renderedBuffer.getChannelData(0);
        }

        // Monotonic Multi-File Progress Aggregator (Anti-Jitter)
        const downloadTracker = {
            files: {},
            lastReportedPct: 0,
            reset() {
                this.files = {};
                this.lastReportedPct = 0;
            },
            update(fileName, loaded, total) {
                this.files[fileName] = { loaded, total };
                let totalLoaded = 0;
                let totalExpected = 0;
                for (const k in this.files) {
                    totalLoaded += this.files[k].loaded;
                    totalExpected += this.files[k].total;
                }
                if (totalExpected === 0) return { pct: 0, loadedMB: "0", totalMB: "0" };
                const rawPct = Math.round((totalLoaded / totalExpected) * 100);
                this.lastReportedPct = Math.min(99, Math.max(this.lastReportedPct, rawPct));
                return {
                    pct: this.lastReportedPct,
                    loadedMB: (totalLoaded / (1024 * 1024)).toFixed(1),
                    totalMB: (totalExpected / (1024 * 1024)).toFixed(1)
                };
            }
        };

        // Worker Initialization
        function initWorker() {
            if (!worker) {
                worker = new Worker('worker.js', { type: 'module' });
                worker.onmessage = handleWorkerMessage;
            }
        }

        // Start Execution
        startBtn.addEventListener('click', async () => {
            if (!selectedFile) return;

            initWorker();
            downloadTracker.reset();
            startBtn.disabled = true;
            progressSection.classList.remove('hidden');
            resultSection.classList.add('hidden');
            progressBar.style.width = "5%";
            percentText.textContent = "5%";
            statusMessage.textContent = currentLang === 'zh' ? "正在解析媒体文件..." : "Parsing media...";
            subStageFile.textContent = selectedFile.name;

            try {
                audioFloat32 = await extractAudioData(selectedFile);

                statusMessage.textContent = currentLang === 'zh' ? "调度神经网络计算资源..." : "Allocating neural tensors...";
                percentText.textContent = "30%";
                progressBar.style.width = "30%";

                worker.postMessage({
                    type: 'transcribe',
                    payload: {
                        audioData: audioFloat32,
                        modelId: modelSelect.value,
                        language: langSelect.value,
                        device: deviceSelect.value,
                        mirror: currentMirror
                    }
                });
            } catch (err) {
                alert("Error: " + err.message);
                startBtn.disabled = false;
                progressSection.classList.add('hidden');
            }
        });

        // Worker Event Dispatcher
        function handleWorkerMessage(e) {
            const { type, data } = e.data;

            if (type === 'download_progress') {
                subStageStatus.textContent = i18n[currentLang].step1Label;
                if (data.status === 'progress' && data.total > 0) {
                    const stats = downloadTracker.update(data.file || 'core', data.loaded, data.total);
                    statusMessage.textContent = currentLang === 'zh' 
                        ? `同步模型权重: ${stats.loadedMB}MB / ${stats.totalMB}MB (${stats.pct}%)` 
                        : `Syncing weights: ${stats.loadedMB}MB / ${stats.totalMB}MB (${stats.pct}%)`;
                    subStageFile.textContent = currentLang === 'zh' ? "声学编码与文本生成核心组件" : "Acoustic & text synthesis core";
                    percentText.textContent = `${stats.pct}%`;
                    progressBar.style.width = `${stats.pct}%`;
                } else if (data.status === 'done') {
                    statusMessage.textContent = currentLang === 'zh' ? "权重加载完毕，正在分配显卡显存..." : "Weights loaded, allocating VRAM...";
                    updateCacheDisplay();
                }
            } else if (type === 'status') {
                statusMessage.textContent = data.message;
                if (data.phase === 'transcribing') {
                    subStageStatus.textContent = i18n[currentLang].step2Label;
                    subStageFile.textContent = "Apple WebGPU Neural Compute";
                    percentText.textContent = "75%";
                    progressBar.style.width = "75%";
                    updateCacheDisplay();
                }
            } else if (type === 'complete') {
                progressBar.style.width = "100%";
                percentText.textContent = "100%";
                statusMessage.textContent = currentLang === 'zh' ? "转写完成" : "Transcription complete";
                subStageStatus.textContent = "Completed";
                updateCacheDisplay();

                setTimeout(() => {
                    progressSection.classList.add('hidden');
                    startBtn.disabled = false;
                    renderResults(data);
                }, 400);

            } else if (type === 'error') {
                alert("Transcription Error: " + data.message);
                progressSection.classList.add('hidden');
                startBtn.disabled = false;
            }
        }

        // Time Helpers
        function formatSeconds(sec) {
            const m = Math.floor(sec / 60);
            const s = Math.floor(sec % 60);
            return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }

        function formatSrtTime(sec) {
            const h = Math.floor(sec / 3600);
            const m = Math.floor((sec % 3600) / 60);
            const s = Math.floor(sec % 60);
            const ms = Math.floor((sec % 1) * 1000);
            return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')},${String(ms).padStart(3, '0')}`;
        }

        function formatVttTime(sec) {
            const h = Math.floor(sec / 3600);
            const m = Math.floor((sec % 3600) / 60);
            const s = Math.floor(sec % 60);
            const ms = Math.floor((sec % 1) * 1000);
            return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}.${String(ms).padStart(3, '0')}`;
        }

        // Render Results (with OpenCC normalization)
        function renderResults(res) {
            subtitleChunks = res.chunks;

            if (window.OpenCC) {
                try {
                    const converter = OpenCC.Converter({ from: 'hk', to: 'cn' });
                    subtitleChunks.forEach(c => {
                        if (c.text) c.text = converter(c.text);
                    });
                } catch(e) {}
            }

            resultSection.classList.remove('hidden');
            speedBadge.textContent = `${res.durationSec}s · ${res.deviceUsed.toUpperCase()}`;
            segmentCount.textContent = subtitleChunks.length;

            subtitlesList.innerHTML = '';
            let vttContent = "WEBVTT\n\n";

            subtitleChunks.forEach((chunk, index) => {
                const start = chunk.timestamp[0] ?? 0;
                const end = chunk.timestamp[1] ?? (start + 2);
                const text = chunk.text.trim();

                vttContent += `${formatVttTime(start)} --> ${formatVttTime(end)}\n${text}\n\n`;

                const item = document.createElement('div');
                item.className = "flex items-start space-x-2.5 p-2 rounded-lg bg-black/30 hover:bg-white/[0.06] border border-white/[0.06] transition cursor-pointer";
                item.innerHTML = `
                    <button class="text-[11px] font-mono text-zinc-400 bg-white/[0.08] hover:bg-white/[0.14] px-1.5 py-0.5 rounded border border-white/[0.1] flex-shrink-0 transition" title="跳转播放">
                        ${formatSeconds(start)}
                    </button>
                    <div class="flex-1 text-xs text-zinc-200 outline-none focus:bg-white/[0.06] focus:p-1 focus:rounded leading-relaxed" contenteditable="true" data-index="${index}">
                        ${text}
                    </div>
                `;

                item.querySelector('button').addEventListener('click', (e) => {
                    e.stopPropagation();
                    videoPlayer.currentTime = start;
                    videoPlayer.play();
                });

                item.querySelector('[contenteditable]').addEventListener('blur', (e) => {
                    subtitleChunks[index].text = e.target.innerText.trim();
                });

                subtitlesList.appendChild(item);
            });

            // Live Track
            if (vttBlobUrl) URL.revokeObjectURL(vttBlobUrl);
            const vttBlob = new Blob([vttContent], { type: 'text/vtt' });
            vttBlobUrl = URL.createObjectURL(vttBlob);

            while (videoPlayer.getElementsByTagName('track').length > 0) {
                videoPlayer.removeChild(videoPlayer.getElementsByTagName('track')[0]);
            }

            const track = document.createElement('track');
            track.kind = 'subtitles';
            track.label = 'Subtitles';
            track.srclang = 'zh';
            track.src = vttBlobUrl;
            track.default = true;
            videoPlayer.appendChild(track);
        }

        // Export Actions
        document.getElementById('downloadSrtBtn').addEventListener('click', () => {
            if (!subtitleChunks.length) return;
            let srt = '';
            subtitleChunks.forEach((c, idx) => {
                const s = c.timestamp[0] ?? 0;
                const e = c.timestamp[1] ?? (s + 2);
                srt += `${idx + 1}\n${formatSrtTime(s)} --> ${formatSrtTime(e)}\n${c.text.trim()}\n\n`;
            });
            downloadFile(srt, `${selectedFile.name.replace(/\.[^/.]+$/, "")}.srt`, 'text/plain');
        });

        document.getElementById('downloadVttBtn').addEventListener('click', () => {
            if (!subtitleChunks.length) return;
            let vtt = 'WEBVTT\n\n';
            subtitleChunks.forEach((c) => {
                const s = c.timestamp[0] ?? 0;
                const e = c.timestamp[1] ?? (s + 2);
                vtt += `${formatVttTime(s)} --> ${formatVttTime(e)}\n${c.text.trim()}\n\n`;
            });
            downloadFile(vtt, `${selectedFile.name.replace(/\.[^/.]+$/, "")}.vtt`, 'text/vtt');
        });

        document.getElementById('downloadTxtBtn').addEventListener('click', () => {
            if (!subtitleChunks.length) return;
            const txt = subtitleChunks.map(c => c.text.trim()).join('\n');
            downloadFile(txt, `${selectedFile.name.replace(/\.[^/.]+$/, "")}.txt`, 'text/plain');
        });

        document.getElementById('copyAllBtn').addEventListener('click', (e) => {
            if (!subtitleChunks.length) return;
            const txt = subtitleChunks.map(c => c.text.trim()).join('\n');
            navigator.clipboard.writeText(txt);
            const orig = e.currentTarget.innerHTML;
            e.currentTarget.innerHTML = `<i class="fa-solid fa-check text-xs text-emerald-400"></i>`;
            setTimeout(() => e.currentTarget.innerHTML = orig, 1200);
        });

        function downloadFile(content, fileName, mimeType) {
            const blob = new Blob([content], { type: mimeType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // Initialize default view
        switchLanguage('zh');
    </script>
</body>
</html>
