            <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-400" id="faqHeaderTitle">技术架构与规范说明</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-zinc-400" id="faqContainer">
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#202327] bg-[#090a0b] text-zinc-500 text-xs py-4">
        <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px]">
